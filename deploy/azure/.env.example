# Copie para /opt/avanza/.env na VM (dono avanza-runner, chmod 600). Nunca versione o .env.
COMPOSE_PROFILES=app            # echo = teste de rede; app = produção
UPSTREAM=avanza:8090            # echo:8080 no teste de rede
APPGW_SUBNET=10.200.3.240/28
STORAGE_API_VERSION=            # mesma versão do storage-api do Supabase local

KAMBAN_DATABASE_URL=postgresql://avanza_app:SENHA@SERVIDOR.postgres.database.azure.com:5432/avanza
KAMBAN_DB_SSL=require
KAMBAN_DB_SCHEMA=avanza
KAMBAN_STORAGE_BUCKET=avanza-files
KAMBAN_SECRET_KEY=              # a MESMA do servidor antigo (cifra a senha do SMTP)
KAMBAN_TRUSTED_PROXY=172.30.0.0/24,10.200.3.240/28,172.31.0.0/24
TZ=America/Sao_Paulo

STORAGE_JWT_SECRET=
STORAGE_ANON_KEY=
KAMBAN_SUPABASE_SECRET_KEY=     # JWT service_role assinado com STORAGE_JWT_SECRET
STORAGE_DB_PASSWORD=
