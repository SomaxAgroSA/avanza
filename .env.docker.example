# Copie para .env (na raiz) antes do `docker compose up`. Nunca versione o .env.

# Supabase da empresa (Cloud: Project Settings; auto-hospedado: o .env do Docker do Supabase)
# Conexão do Postgres: direta ou Supavisor em modo SESSÃO (porta 5432) — o modo transação não serve
KAMBAN_DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
KAMBAN_DB_SSL=require
KAMBAN_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave secreta (sb_secret_… ou service_role): só o servidor usa, para os arquivos
KAMBAN_SUPABASE_SECRET_KEY=

# Chave do servidor (cifra a senha do SMTP no banco): gere uma vez, ex. `openssl rand -base64 32`
KAMBAN_SECRET_KEY=

# Super administrador (criado/atualizado a cada início; pode apagar depois do primeiro)
KAMBAN_ADMIN_EMAIL=admin@empresa.com
# mínimo 10 caracteres, com letras e números
KAMBAN_ADMIN_PASSWORD=
KAMBAN_ADMIN_NAME=Administrador
TZ=America/Sao_Paulo
