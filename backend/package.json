{
  "name": "kamban-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Backend do Avanza: API em Node (Fastify) sobre o Supabase (Postgres + Storage)",
  "license": "Apache-2.0",
  "scripts": {
    "start": "node scripts/start.js",
    "setup": "node scripts/setup.js",
    "dev": "node scripts/dev.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:api": "node --test --test-concurrency=1 \"tests/api/**/*.test.js\"",
    "test:all": "npm run test && npm run test:db && npm run test:api",
    "coverage": "node --test --experimental-test-coverage \"tests/unit/**/*.test.js\"",
    "lint": "eslint .",
    "create-admin": "node scripts/create-admin.js",
    "demo": "node scripts/demo.js",
    "load": "node scripts/load-test.js",
    "load:docs": "node scripts/load-docs.js",
    "test:db": "node --test --test-concurrency=1 \"tests/db/**/*.test.js\"",
    "import:pocketbase": "node scripts/import-pocketbase.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1"
  },
  "main": "src/server.js"
}
