# Copie para backend/.env e ajuste (ou rode `npm run setup` com o Supabase local no ar). Nunca versione o .env.

# development | production | test
KAMBAN_ENV=development
KAMBAN_VERSION=0.1.0
# endereço da API (e do frontend servido por ela); 0.0.0.0 para atender a rede
KAMBAN_HTTP=127.0.0.1:8090

# Supabase (ADR-044) — local: `supabase status` na raiz do repositório mostra os valores
# Conexão direta do Postgres (ou o Supavisor em modo sessão, porta 5432): transações, travas e tempo real
KAMBAN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# esquema das tabelas do Avanza (criado sozinho)
KAMBAN_DB_SCHEMA=avanza
# conexões no pool da API
KAMBAN_DB_POOL=10
# disable | require | verify-full (com KAMBAN_DB_CA_FILE quando a empresa usa CA própria)
KAMBAN_DB_SSL=disable
KAMBAN_DB_CA_FILE=
# Storage (arquivos): endereço do Supabase e a chave secreta (sb_secret_… ou service_role)
KAMBAN_SUPABASE_URL=http://127.0.0.1:54321
KAMBAN_SUPABASE_SECRET_KEY=
# bucket privado (criado sozinho)
KAMBAN_STORAGE_BUCKET=avanza-files

# Chave do servidor que cifra os segredos guardados no banco (senha do SMTP). Obrigatória em produção;
# gere uma vez (ex.: openssl rand -base64 32) e guarde com cuidado — trocar exige salvar o SMTP de novo.
KAMBAN_SECRET_KEY=

# Atrás de proxy reverso: IPs/sub-redes do proxy (ou true) para enxergar o IP real no X-Forwarded-For
KAMBAN_TRUSTED_PROXY=
# Limites por IP (JSON; vazio = padrão: 10 logins/min, 600 chamadas/min na API)
KAMBAN_RATE_LIMITS=

# Sessão web
KAMBAN_SESSION_TTL_HOURS=12
KAMBAN_SESSION_REMEMBER_DAYS=30
KAMBAN_SESSION_IDLE_MINUTES=120
KAMBAN_SESSION_TOUCH_SECONDS=300
# Em produção o cookie é sempre Secure. Em dev com HTTPS local, pode forçar:
KAMBAN_COOKIE_SECURE=false

# Usado apenas por `npm run create-admin` (super administrador inicial)
KAMBAN_ADMIN_EMAIL=
KAMBAN_ADMIN_PASSWORD=
KAMBAN_ADMIN_NAME=Administrador
